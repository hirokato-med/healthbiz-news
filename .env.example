# 記事の取得元。未設定なら本番の JSON（GitHub の data/articles.json）を読む
#   mock      → サンプル記事で動かす（画面を作るとき）
#   supabase  → Supabase を読む（下の2行が必要）
#   URL       → その JSON を読む
EXPO_PUBLIC_ARTICLES_URL=mock

# EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# 配信パイプラインを Supabase に向ける場合のみ（アプリには入れない）
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
