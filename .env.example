# 記事の取得元（どれか1つ。無ければサンプル記事で動く）

# A. GitHub 上の JSON を読む（追加のサービス不要）
EXPO_PUBLIC_ARTICLES_URL=https://raw.githubusercontent.com/hirokato-med/healthbiz-news/main/data/articles.json

# B. Supabase を読む
# EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# 配信パイプライン（Supabase に書き込む場合のみ。アプリには入れない）
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
